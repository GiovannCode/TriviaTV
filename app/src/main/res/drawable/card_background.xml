<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused State (when navigating with TV remote D-pad) -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#3D206B" />
            <corners android:radius="16dp" />
            <stroke android:width="4dp" android:color="#00E5FF" />
        </shape>
    </item>
    <!-- Pressed State -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#4A2880" />
            <corners android:radius="16dp" />
            <stroke android:width="4dp" android:color="#7C4DFF" />
        </shape>
    </item>
    <!-- Normal State -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1F1635" />
            <corners android:radius="16dp" />
            <stroke android:width="2dp" android:color="#4A3B6B" />
        </shape>
    </item>
</selector>